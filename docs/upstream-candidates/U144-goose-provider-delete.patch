+fn provider_deletions_dir() -> PathBuf {
+    Paths::config_dir().join("pending_provider_deletions")
+}
+
+fn lock_provider_deletions_in(directory: &std::path::Path) -> Result<std::fs::File> {
+    std::fs::create_dir_all(directory)?;
+    let lock = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(directory.join(".lock"))?;
+    lock.lock_exclusive()?;
+    Ok(lock)
+}
+
+fn provider_deletion_path_in(directory: &std::path::Path, id: &str) -> Result<PathBuf> {
+    validate_provider_id(id).or_else(|_| custom_provider_file_path(id).map(|_| ()))?;
+    let digest = crate::utils::bytes_to_hex(Sha256::digest(id.as_bytes()));
+    Ok(directory.join(format!("{digest}.json")))
+}
+
+fn sync_directory(path: &std::path::Path) -> Result<()> {
+    #[cfg(unix)]
+    {
+        let directory = std::fs::File::open(path)?;
+        directory.sync_all()?;
+    }
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
+
+fn persist_pending_provider_deletion(
+    path: &std::path::Path,
+    pending: &PendingProviderDeletion,
+) -> Result<()> {
+    let directory = path
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("provider deletion journal has no parent"))?;
+    std::fs::create_dir_all(directory)?;
+    let payload = serde_json::to_vec_pretty(pending)?;
+    let mut builder = tempfile::Builder::new();
+    builder.prefix(".provider-deletion-").suffix(".tmp");
+    let mut temporary = create_private_named_temp_file(&mut builder, directory)?;
+    temporary.write_all(&payload)?;
+    temporary.as_file().sync_all()?;
+    persist_private_temporary_file(temporary, path)?;
+    sync_directory(directory)
+}
+
+fn write_pending_provider_deletion_in(
+    directory: &std::path::Path,
+    id: &str,
+    api_key_env: &str,
+) -> Result<PathBuf> {
+    let path = provider_deletion_path_in(directory, id)?;
+    let pending = PendingProviderDeletion {
+        version: 1,
+        provider_id: id.to_string(),
+        owned_api_key_env: (api_key_env == generate_api_key_name(id))
+            .then(|| api_key_env.to_string()),
+        completed: false,
+    };
+    persist_pending_provider_deletion(&path, &pending)?;
+    Ok(path)
+}
+
+fn complete_pending_provider_deletion_in(
+    config: &Config,
+    custom_directory: &std::path::Path,
+    journal_directory: &std::path::Path,
+    path: &std::path::Path,
+) -> Result<()> {
+    let mut pending: PendingProviderDeletion = serde_json::from_slice(&std::fs::read(path)?)?;
+    if pending.version != 1
+        || provider_deletion_path_in(journal_directory, &pending.provider_id)? != path
+    {
+        anyhow::bail!("provider deletion journal identity mismatch");
+    }
+    custom_provider_file_path(&pending.provider_id)?;
+    if pending
+        .owned_api_key_env
+        .as_deref()
+        .is_some_and(|name| name != generate_api_key_name(&pending.provider_id))
+    {
+        anyhow::bail!("provider deletion journal secret ownership mismatch");
+    }
+
+    let definition = custom_directory.join(format!("{}.json", pending.provider_id));
+    if pending.completed {
+        if definition.exists() {
+            anyhow::bail!(
+                "provider id was reused after completed deletion: {}",
+                pending.provider_id
+            );
+        }
+        return Ok(());
+    }
+    match std::fs::remove_file(&definition) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    sync_directory(custom_directory)?;
+    crate::config::remove_provider_entry(config, &pending.provider_id)?;
+    if let Some(api_key_env) = pending.owned_api_key_env.as_deref() {
+        config.delete_secret_if_present(api_key_env)?;
+    }
+    pending.completed = true;
+    persist_pending_provider_deletion(path, &pending)
+}
+
+fn recover_pending_provider_deletions_in(
+    config: &Config,
+    custom_directory: &std::path::Path,
+    directory: &std::path::Path,
+) -> Result<()> {
+    if !directory.exists() {
+        return Ok(());
+    }
+    let mut journals = std::fs::read_dir(directory)?.collect::<std::io::Result<Vec<_>>>()?;
+    journals.sort_by_key(|entry| entry.file_name());
+    for entry in journals {
+        let path = entry.path();
+        if path.extension().and_then(|extension| extension.to_str()) != Some("json") {
+            continue;
+        }
+        let pending: PendingProviderDeletion = serde_json::from_slice(&std::fs::read(&path)?)?;
+        if pending.completed {
+            // A completed receipt is a tombstone, not a delayed delete command.
+            // Keeping it prevents generated IDs from being reused; startup must
+            // never apply it to a manually restored definition with the same ID.
+            continue;
+        }
+        complete_pending_provider_deletion_in(config, custom_directory, directory, &path)?;
+    }
+    Ok(())
+}
+
+pub fn recover_pending_provider_deletions() -> Result<()> {
+    let _guard = PROVIDER_DELETION_LOCK.lock().unwrap();
+    let journal_directory = provider_deletions_dir();
+    let _storage_lock = lock_provider_deletions_in(&journal_directory)?;
+    recover_pending_provider_deletions_in(
+        Config::global(),
+        &custom_providers_dir(),
+        &journal_directory,
+    )
+}
