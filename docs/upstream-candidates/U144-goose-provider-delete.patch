+    /// Delete a secret only when it exists, without rewriting unchanged storage.
+    pub fn delete_secret_if_present(&self, key: &str) -> Result<bool, ConfigError> {
+        let _guard = self.guard.lock().unwrap();
+        let _storage_lock = self.lock_secrets_for_mutation()?;
+        let mut values = self.load_secrets_from_storage()?;
+        if values.remove(key).is_none() {
+            return Ok(false);
+        }
+        self.write_all_secrets(&values)?;
+        Ok(true)
+    }
