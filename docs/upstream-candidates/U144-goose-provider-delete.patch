+    /// Read-modify-write an existing configuration value without creating it.
+    /// Returns false, without rewriting the file, when the key is absent.
+    pub fn update_param_if_present<T, V, F>(&self, key: &str, f: F) -> Result<bool, ConfigError>
+    where
+        T: for<'de> Deserialize<'de>,
+        V: Serialize,
+        F: FnOnce(T) -> Option<V>,
+    {
+        let _guard = self.guard.lock().unwrap();
+        let mut values = self.load_write_config()?;
+        let Some(raw) = values.get(key) else {
+            return Ok(false);
+        };
+        let current = serde_yaml::from_value::<T>(raw.clone())?;
+        let Some(updated) = f(current) else {
+            return Ok(false);
+        };
+        values.insert(serde_yaml::to_value(key)?, serde_yaml::to_value(updated)?);
+        self.save_values(&values)?;
+        Ok(true)
+    }
+
