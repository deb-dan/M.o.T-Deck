+        remove_custom_provider_in(&config, &custom_dir, &journal_dir, id).unwrap();
+        write_provider_with_key(&custom_dir, id, "");
+
+        recover_pending_provider_deletions_in(&config, &custom_dir, &journal_dir).unwrap();
+        assert!(custom_dir.join(format!("{id}.json")).exists());
+
+        let error = remove_custom_provider_in(&config, &custom_dir, &journal_dir, id).unwrap_err();
+
+        assert!(error.to_string().contains("id was reused"));
+        assert!(custom_dir.join(format!("{id}.json")).exists());
+    }
+
