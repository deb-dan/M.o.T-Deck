index 0000000000000000000000000000000000000000..68bf2fc66995aefdced2e389861bd4ad9cdc2dbd
--- /dev/null
+++ b/tests/tools/test_local_execution_confinement.py
@@ -0,0 +1,168 @@
+"""Real macOS boundary checks for local terminal and execute_code children."""
+
+import json
+import os
+import shlex
+import socket
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+import tools.environments.local_confinement as local_confinement
+from hermes_cli.config import get_config_path
+from tools.code_execution_tool import execute_code
+from tools.code_kernel import shutdown_all_kernels
+from tools.environments.local import LocalEnvironment
+from tools.environments.local_confinement import LocalConfinementError
+from tools.process_registry import ProcessRegistry
+
+
+def _config(writable_root: Path, provider: str = "macos-seatbelt") -> dict:
+    return {
+        "terminal": {
+            "local_confinement": {
+                "provider": provider,
+                "writable_roots": [str(writable_root)],
+            }
+        }
+    }
+
+
+def _write_config(writable_root: Path, provider: str = "macos-seatbelt") -> None:
+    path = get_config_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        yaml.safe_dump(_config(writable_root, provider), sort_keys=False),
+        encoding="utf-8",
+    )
+
+
+@pytest.fixture(autouse=True)
+def _fresh_kernels():
+    shutdown_all_kernels()
+    yield
+    shutdown_all_kernels()
+
+
+@pytest.mark.macos_only
+def test_real_boundary_covers_terminal_python_children_and_session_kernel(tmp_path, monkeypatch):
+    allowed = tmp_path / "allowed"
+    protected = tmp_path / "protected"
+    allowed.mkdir()
+    protected.mkdir()
+    protected_file = protected / "original.txt"
+    protected_file.write_text("unchanged", encoding="utf-8")
+    socket_temp = tempfile.TemporaryDirectory(prefix="hermes-confine-", dir="/tmp")
+    unix_socket_path = Path(socket_temp.name) / "escape.sock"
+    unix_listener = socket.socket(socket.AF_UNIX)
+    unix_listener.bind(str(unix_socket_path))
+    unix_listener.listen()
+    tcp_listener = socket.socket()
+    tcp_listener.bind(("127.0.0.1", 0))
+    tcp_listener.listen()
+    monkeypatch.setenv("BOUNDARY_ALLOWED", str(allowed))
+    monkeypatch.setenv("BOUNDARY_PROTECTED", str(protected))
+    monkeypatch.setenv("BOUNDARY_SOCKET", str(unix_socket_path))
+    monkeypatch.setenv("BOUNDARY_TCP_PORT", str(tcp_listener.getsockname()[1]))
+    _write_config(allowed)
+
+    probe = """
+import os
+import pathlib
+import socket
+import subprocess
+
+allowed = pathlib.Path(os.environ["BOUNDARY_ALLOWED"])
+protected = pathlib.Path(os.environ["BOUNDARY_PROTECTED"])
+(allowed / "ordinary.txt").write_text("allowed")
+for action in (
+    lambda: (protected / "python.txt").write_text("blocked"),
+    lambda: ((allowed / "escape").symlink_to(protected), (allowed / "escape" / "link.txt").write_text("blocked")),
+    lambda: os.link(protected / "original.txt", allowed / "hardlink.txt"),
+):
+    try:
+        action()
+    except OSError:
+        pass
+subprocess.run(["/bin/sh", "-c", 'echo blocked > "$BOUNDARY_PROTECTED/subprocess.txt"'], check=False)
+subprocess.run(["/bin/sh", "-c", '(sleep 0.05; echo blocked > "$BOUNDARY_PROTECTED/background.txt") & wait'], check=False)
+unix_client = socket.socket(socket.AF_UNIX)
+try:
+    assert unix_client.connect_ex(os.environ["BOUNDARY_SOCKET"]) != 0
+finally:
+    unix_client.close()
+tcp_client = socket.socket()
+try:
+    assert tcp_client.connect_ex(("127.0.0.1", int(os.environ["BOUNDARY_TCP_PORT"]))) == 0
+finally:
+    tcp_client.close()
+assert not (protected / "python.txt").exists()
+assert not (protected / "link.txt").exists()
+assert not (allowed / "hardlink.txt").exists()
+assert not (protected / "subprocess.txt").exists()
+assert not (protected / "background.txt").exists()
+print("all blocked")
+"""
+
+    try:
+        terminal = LocalEnvironment(cwd=str(allowed), env=dict(os.environ))
+        terminal_result = terminal.execute(f"python3 -c {shlex.quote(probe)}")
+        assert terminal_result["returncode"] == 0, terminal_result
+        assert terminal_result["execution_confinement"] == "macos-seatbelt"
+
+        registry = ProcessRegistry()
+        for use_pty, name in ((False, "background-pipe"), (True, "background-pty")):
+            session = registry.spawn_local(
+                f'echo blocked > "$BOUNDARY_PROTECTED/{name}.txt"; echo settled',
+                cwd=str(allowed),
+                env_vars={
+                    "BOUNDARY_ALLOWED": str(allowed),
+                    "BOUNDARY_PROTECTED": str(protected),
+                },
+                use_pty=use_pty,
+            )
+            settled = registry.wait(session.id, timeout=10)
+            assert settled["status"] == "exited", settled
+            assert settled["execution_confinement"] == "macos-seatbelt"
+            if use_pty:
+                assert session._pty is not None
+
+        with patch(
+            "tools.code_execution_tool._load_config",
+            return_value={"mode": "strict", "kernel_mode": "session", "timeout": 30},
+        ):
+            kernel_result = json.loads(execute_code(
+                'from pathlib import Path\n'
+                'try:\n'
+                f'    (Path({str(protected)!r}) / "kernel.txt").write_text("blocked")\n'
+                'except OSError:\n'
+                '    print("blocked")',
+                task_id="confinement-proof",
+            ))
+    finally:
+        unix_listener.close()
+        tcp_listener.close()
+        socket_temp.cleanup()
+
+    assert kernel_result["status"] == "success", kernel_result
+    assert kernel_result["execution_confinement"] == "macos-seatbelt"
+    assert "blocked" in kernel_result["output"]
+    assert protected_file.read_text(encoding="utf-8") == "unchanged"
+    assert sorted(path.name for path in protected.iterdir()) == ["original.txt"]
+
+
+@pytest.mark.macos_only
+def test_configured_unknown_provider_fails_before_local_child_spawn(tmp_path):
+    _write_config(tmp_path, provider="not-a-provider")
+    with pytest.raises(LocalConfinementError, match="unsupported"):
+        LocalEnvironment(cwd=str(tmp_path))
+
+    _write_config(tmp_path)
+    with (
+        patch.object(local_confinement, "_MACOS_SEATBELT_RUNNER", str(tmp_path / "missing")),
+    ):
+        with pytest.raises(LocalConfinementError, match="runner is unavailable"):
+            LocalEnvironment(cwd=str(tmp_path))
