index 0000000000000000000000000000000000000000..ce0434115125cc106597c9ee568117b98efcc8fa
--- /dev/null
+++ b/tools/environments/local_confinement.py
@@ -0,0 +1,136 @@
+"""Optional OS-enforced write confinement for local terminal and Python children."""
+
+from __future__ import annotations
+
+import os
+import platform
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterable, Mapping, Sequence
+
+_MACOS_SEATBELT_RUNNER = "/usr/bin/sandbox-exec"
+
+
+class LocalConfinementError(RuntimeError):
+    """The configured local execution boundary cannot be established safely."""
+
+
+def terminal_confinement_runtime_dir() -> Path:
+    """Private temp root shared by confined local terminal spawn shapes."""
+    from hermes_constants import get_hermes_home
+
+    root = get_hermes_home() / "cache" / "terminal" / "confined"
+    root.mkdir(parents=True, exist_ok=True, mode=0o700)
+    try:
+        root.chmod(0o700)
+    except OSError:
+        pass
+    return root
+
+
+def _scheme_literal(value: str) -> str:
+    if any(ord(char) < 32 for char in value):
+        raise LocalConfinementError("writable roots cannot contain control characters")
+    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+
+def _canonical_root(raw: object) -> str:
+    if not isinstance(raw, str) or not raw.strip():
+        raise LocalConfinementError("each writable root must be a non-empty path")
+    expanded = os.path.expanduser(raw.strip())
+    if not os.path.isabs(expanded):
+        raise LocalConfinementError(f"writable root must be absolute: {raw!r}")
+    resolved = os.path.realpath(expanded)
+    if resolved == os.path.sep:
+        raise LocalConfinementError("filesystem root cannot be a writable root")
+    if not os.path.isdir(resolved):
+        raise LocalConfinementError(f"writable root is not an existing directory: {raw!r}")
+    return resolved
+
+
+@dataclass(frozen=True)
+class LocalConfinementPolicy:
+    provider: str
+    writable_roots: tuple[str, ...]
+    runner: str
+
+    @property
+    def cache_key(self) -> tuple[str, tuple[str, ...], str]:
+        return self.provider, self.writable_roots, self.runner
+
+    def prepare_spawn(
+        self,
+        argv: Sequence[str],
+        env: Mapping[str, str],
+        *,
+        runtime_writable_roots: Iterable[str] = (),
+    ) -> tuple[list[str], dict[str, str], str]:
+        roots = tuple(dict.fromkeys(
+            (*self.writable_roots, *(_canonical_root(root) for root in runtime_writable_roots))
+        ))
+        if not roots:
+            raise LocalConfinementError("local confinement requires at least one writable root")
+
+        write_filters = " ".join(
+            f"(subpath {_scheme_literal(root)})" for root in roots
+        )
+        profile = " ".join((
+            "(version 1)",
+            "(deny default)",
+            "(allow process*)",
+            "(allow sysctl-read)",
+            "(allow mach-lookup)",
+            "(allow signal)",
+            "(allow file-read*)",
+            "(allow network-outbound (remote ip) "
+            "(literal \"/private/var/run/mDNSResponder\"))",
+            "(allow network-inbound)",
+            "(allow ipc-posix*)",
+            "(allow file-write* (literal \"/dev/null\") (literal \"/dev/tty\") "
+            f"{write_filters})",
+        ))
+        child_env = dict(env)
+        runtime_roots = tuple(_canonical_root(root) for root in runtime_writable_roots)
+        if runtime_roots:
+            child_env.update({name: runtime_roots[0] for name in ("TMPDIR", "TMP", "TEMP")})
+        return [self.runner, "-p", profile, *argv], child_env, self.provider
+
+
+def load_local_confinement_policy() -> LocalConfinementPolicy | None:
+    """Resolve the configured provider once for one child-spawn decision."""
+    from hermes_cli import managed_scope
+    from hermes_cli.config import get_config_path, load_config
+
+    user_config = get_config_path()
+    managed_dir = managed_scope.get_managed_dir()
+    managed_config = managed_dir / "config.yaml" if managed_dir else None
+    if not user_config.is_file() and not (
+        managed_config is not None and managed_config.is_file()
+    ):
+        # The default policy is disabled. Avoid making a previously side-effect-free
+        # child spawn create HERMES_HOME merely to rediscover that default.
+        return None
+
+    config = load_config() or {}
+    terminal = config.get("terminal") if isinstance(config, dict) else None
+    raw = terminal.get("local_confinement") if isinstance(terminal, dict) else None
+    if not isinstance(raw, dict):
+        return None
+    provider = str(raw.get("provider") or "").strip()
+    if not provider:
+        return None
+    if provider != "macos-seatbelt":
+        raise LocalConfinementError(f"unsupported local confinement provider: {provider}")
+    if platform.system() != "Darwin":
+        raise LocalConfinementError("macos-seatbelt local confinement requires macOS")
+    runner = _MACOS_SEATBELT_RUNNER
+    if not os.path.isfile(runner) or not os.access(runner, os.X_OK):
+        raise LocalConfinementError(f"configured confinement runner is unavailable: {runner}")
+    roots = raw.get("writable_roots")
+    if not isinstance(roots, list):
+        raise LocalConfinementError("local confinement writable_roots must be a list")
+    return LocalConfinementPolicy(
+        provider=provider,
+        writable_roots=tuple(dict.fromkeys(_canonical_root(root) for root in roots)),
+        runner=runner,
+    )
