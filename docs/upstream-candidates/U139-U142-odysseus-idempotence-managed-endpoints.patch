+def _provision_body(**overrides):
+    body = {
+        "manager_id": "mot",
+        "resource_id": "aux",
+        "management_token": "m" * 48,
+        "name": "M.O.T Aux",
+        "base_url": "http://127.0.0.1:6768/v1",
+        "api_key": "old-aux-key",
+        "pinned_models": ["small-model"],
+    }
+    body.update(overrides)
+    return body
+
