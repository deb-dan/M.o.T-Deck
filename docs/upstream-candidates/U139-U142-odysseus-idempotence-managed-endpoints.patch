+def test_identical_replay_returns_the_original_receipt(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-replay"
+    message = ChatMessage("user", "Keep this once", {"source": "mot-direct"})
+
+    first = _manager().put_idempotent_messages(session_id, request_id, [message])
+    replay = _manager().put_idempotent_messages(session_id, request_id, [message])
+
+    assert first["status"] == "inserted"
+    assert replay["status"] == "already_present"
+    assert first["messages"][0]["id"] == replay["messages"][0]["id"]
+    assert first["messages"][0]["inserted"] is True
+    assert replay["messages"][0]["inserted"] is False
+    assert _rows(SessionLocal, session_id) == [{
+        "id": first["messages"][0]["id"],
+        "role": "user",
+        "content": "Keep this once",
+        "metadata": {"source": "mot-direct"},
