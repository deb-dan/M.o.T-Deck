+                    DbChatMessage.session_id == session_id,
+                    DbChatMessage.client_request_id == request_id,
+                ).all()
+                existing = {row.role: row for row in rows}
+                receipts = []
+                now = utcnow_naive()
+
+                for offset, message in enumerate(messages):
+                    metadata = dict(message.metadata or {})
+                    content = persistable_message_content(message.content, metadata)
+                    row = existing.get(message.role)
+                    if row is not None:
+                        try:
+                            stored_metadata = json.loads(row.meta_data) if row.meta_data else {}
+                        except (TypeError, ValueError):
+                            stored_metadata = None
+                        if row.content != content or stored_metadata != metadata:
+                            raise IdempotentMessageConflict(
+                                f"request id already has different {message.role} content"
+                            )
+                        receipts.append({"role": message.role, "id": row.id, "inserted": False})
+                        continue
+
+                    missing_upload_id = reserve_message_upload_references(
+                        getattr(self, "upload_handler", None),
+                        getattr(db_session, "owner", None),
+                        message.content,
+                        metadata,
+                    )
+                    if missing_upload_id:
+                        raise IdempotentMessageUploadMissing(missing_upload_id)
+
+                    row = DbChatMessage(
+                        id=str(uuid.uuid4()),
+                        session_id=session_id,
+                        role=message.role,
+                        content=content,
+                        meta_data=json.dumps(metadata) if metadata else None,
+                        client_request_id=request_id,
+                        timestamp=now + timedelta(microseconds=offset),
+                    )
+                    db.add(row)
+                    receipts.append({"role": message.role, "id": row.id, "inserted": True})
+
+                inserted = sum(1 for receipt in receipts if receipt["inserted"])
+                if inserted:
+                    db.flush()
