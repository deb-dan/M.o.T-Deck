+def test_management_token_and_compare_and_swap_bound_key_rotation(managed_routes):
+    router, _SessionLocal = managed_routes
+    provision = _route(router, "/api/model-endpoints/managed", "POST")
+    resolve = _route(router, "/api/model-endpoints/managed/resolve", "POST")
+    update = _route(router, "/api/model-endpoints/managed/key", "PUT")
+    body = _provision_body()
+    created = asyncio.run(provision(RequestStub(body)))
+    resolved = asyncio.run(resolve(RequestStub({
+        "manager_id": "mot",
+        "resource_id": "aux",
+        "management_token": "m" * 48,
+    })))
+    assert resolved["id"] == created["id"]
+
+    rotation = {
+        "manager_id": "mot",
+        "resource_id": "aux",
+        "management_token": "m" * 48,
+        "endpoint_id": created["id"],
+        "expected_revision": created["management_revision"],
+        "expected_fingerprint": created["api_key_fingerprint"],
+        "api_key": "new-aux-key",
+    }
+    changed = asyncio.run(update(RequestStub(rotation)))
+    replay = asyncio.run(update(RequestStub(rotation)))
+    assert changed["status"] == "updated"
+    assert replay["status"] == "already_present"
+    assert replay["management_revision"] == changed["management_revision"]
+    assert replay["api_key_fingerprint"] == changed["api_key_fingerprint"]
+
+    conflicting = dict(rotation, api_key="third-key")
+    with pytest.raises(HTTPException) as failure:
+        asyncio.run(update(RequestStub(conflicting)))
+    assert failure.value.status_code == 409
+
+    wrong_token = dict(rotation, management_token="x" * 48)
+    with pytest.raises(HTTPException) as hidden:
+        asyncio.run(update(RequestStub(wrong_token)))
+    assert hidden.value.status_code == 404
+
+    rollback = dict(
+        rotation,
+        expected_revision=changed["management_revision"],
+        expected_fingerprint=changed["api_key_fingerprint"],
+        api_key="old-aux-key",
+    )
+    restored = asyncio.run(update(RequestStub(rollback)))
+    assert restored["status"] == "updated"
+    assert restored["management_revision"] == changed["management_revision"] + 1
+    assert restored["api_key_fingerprint"] == created["api_key_fingerprint"]
+
