+def _rows(SessionLocal, session_id):
+    db = SessionLocal()
+    try:
+        return [
+            {
+                "id": row.id,
+                "role": row.role,
+                "content": row.content,
+                "metadata": json.loads(row.meta_data) if row.meta_data else {},
