+@pytest.fixture
+def managed_routes(monkeypatch):
+    SessionLocal, engine, tmpfile = make_temp_sqlite(cdb.Base.metadata)
+    monkeypatch.setattr(model_routes, "SessionLocal", SessionLocal)
+    monkeypatch.setattr(model_routes, "require_admin", lambda _request: None)
+    monkeypatch.setattr(model_routes, "effective_user", lambda _request: "alice")
+    monkeypatch.setattr(
+        "src.endpoint_resolver.resolve_url", lambda value: value
+    )
+    router = model_routes.setup_model_routes(model_discovery=None)
+    try:
+        yield router, SessionLocal
+    finally:
+        engine.dispose()
+        tmpfile.close()
+        try:
+            os.unlink(tmpfile.name)
+        except OSError:
+            pass
+
