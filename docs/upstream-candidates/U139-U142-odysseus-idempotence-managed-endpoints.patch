+def test_provision_is_exclusive_and_retryable_without_storing_token(managed_routes):
+    router, SessionLocal = managed_routes
+    provision = _route(router, "/api/model-endpoints/managed", "POST")
+    body = _provision_body()
+
+    first = asyncio.run(provision(RequestStub(body)))
+    retry = asyncio.run(provision(RequestStub(body)))
+
+    assert first["status"] == "created"
+    assert retry["status"] == "already_present"
+    assert retry["id"] == first["id"]
+    assert retry["api_key_fingerprint"] == first["api_key_fingerprint"]
+    assert len(first["api_key_fingerprint"]) == 64
+    with pytest.raises(HTTPException) as changed_retry:
+        asyncio.run(provision(RequestStub(_provision_body(api_key="changed-on-retry"))))
+    assert changed_retry.value.status_code == 409
+    db = SessionLocal()
+    try:
+        rows = db.query(cdb.ModelEndpoint).all()
+        assert len(rows) == 1
+        row = rows[0]
+        assert row.managed_by == "mot"
+        assert row.managed_resource == "aux"
+        assert row.management_token_hash == model_routes._management_token_hash("m" * 48)
+        assert "m" * 48 not in row.management_token_hash
+    finally:
+        db.close()
