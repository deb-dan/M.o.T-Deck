+def test_route_validates_shape_and_returns_manager_receipt(monkeypatch):
+    import routes.session_routes as session_routes
+
+    class RequestStub:
+        def __init__(self, payload):
+            self._payload = payload
+
+        async def json(self):
+            return self._payload
+
+    class ManagerStub:
+        def __init__(self):
+            self.calls = []
+
+        def put_idempotent_messages(self, session_id, request_id, messages, owner=None):
+            self.calls.append((session_id, request_id, messages, owner))
+            return {
+                "request_id": request_id,
+                "status": "already_present",
+                "messages": [{"role": "user", "id": "stable", "inserted": False}],
+            }
+
+    monkeypatch.setattr(session_routes, "_verify_session_owner", lambda *_args: "alice")
+    monkeypatch.setattr(session_routes, "effective_user", lambda _request: "alice")
+    manager = ManagerStub()
+    configured = session_routes.setup_session_routes(manager, {})
+    endpoint = [
+        route.endpoint
+        for route in configured.routes
+        if getattr(route, "path", "") == "/api/session/{sid}/direct-turn/{request_id}"
+    ][-1]
+
+    result = asyncio.run(endpoint(
+        RequestStub({
+            "messages": [{
+                "role": "user",
+                "content": "Keep once",
+                "metadata": {"source": "mot-direct", "tool_events": ["forged"]},
+            }]
+        }),
+        sid="session",
+        request_id="mot-direct:route-proof",
+    ))
+
+    assert result["status"] == "already_present"
+    assert result["messages"][0]["id"] == "stable"
+    _sid, _request_id, messages, owner = manager.calls[0]
+    assert _sid == "session"
+    assert _request_id == "mot-direct:route-proof"
+    assert owner == "alice"
+    assert messages[0].metadata == {"source": "mot-direct"}
