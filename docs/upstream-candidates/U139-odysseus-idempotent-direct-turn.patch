+def test_legacy_sqlite_migration_adds_column_and_uniqueness(monkeypatch, tmp_path):
+    database_path = tmp_path / "legacy.db"
+    conn = sqlite3.connect(database_path)
+    try:
+        conn.execute(
+            "CREATE TABLE chat_messages ("
+            "id VARCHAR PRIMARY KEY, session_id VARCHAR NOT NULL, "
+            "role VARCHAR NOT NULL, content TEXT NOT NULL)"
+        )
+        conn.commit()
+    finally:
+        conn.close()
+
+    monkeypatch.setattr(cdb, "DATABASE_URL", f"sqlite:///{database_path}")
+    cdb._migrate_add_chat_message_request_id()
+    cdb._migrate_add_chat_message_request_id()
+
+    conn = sqlite3.connect(database_path)
+    try:
+        columns = {row[1] for row in conn.execute("PRAGMA table_info(chat_messages)")}
+        indexes = {row[1] for row in conn.execute("PRAGMA index_list(chat_messages)")}
+        assert "client_request_id" in columns
+        assert "ux_messages_session_client_request_role" in indexes
+        conn.execute(
+            "INSERT INTO chat_messages "
+            "(id, session_id, role, content, client_request_id) "
+            "VALUES ('one', 'session', 'user', 'first', 'request')"
+        )
+        with pytest.raises(sqlite3.IntegrityError):
+            conn.execute(
+                "INSERT INTO chat_messages "
+                "(id, session_id, role, content, client_request_id) "
+                "VALUES ('two', 'session', 'user', 'second', 'request')"
+            )
+        conn.rollback()
+        conn.execute(
+            "INSERT INTO chat_messages "
+            "(id, session_id, role, content, client_request_id) "
+            "VALUES ('null-one', 'session', 'user', 'legacy one', NULL)"
+        )
+        conn.execute(
+            "INSERT INTO chat_messages "
+            "(id, session_id, role, content, client_request_id) "
+            "VALUES ('null-two', 'session', 'user', 'legacy two', NULL)"
+        )
+        conn.commit()
+    finally:
+        conn.close()
+
