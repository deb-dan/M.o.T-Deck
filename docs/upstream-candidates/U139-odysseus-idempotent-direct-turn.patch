+                    content = persistable_message_content(message.content, metadata)
+                    row = existing.get(message.role)
+                    if row is not None:
+                        try:
+                            stored_metadata = json.loads(row.meta_data) if row.meta_data else {}
+                        except (TypeError, ValueError):
+                            stored_metadata = None
+                        if row.content != content or stored_metadata != metadata:
+                            raise IdempotentMessageConflict(
