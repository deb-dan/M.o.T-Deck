+++ b/tests/test_idempotent_direct_turn.py
@@ -0,0 +1,663 @@
+"""Exactly-once storage receipts for externally generated chat turns."""
+
+import concurrent.futures
+import asyncio
+import json
+import os
+import sqlite3
+import threading
+import uuid
+
+import pytest
+
+import core.database as cdb
+import core.session_manager as session_manager_module
+from core.models import ChatMessage
+from tests.helpers.sqlite_db import make_temp_sqlite
+
+
+@pytest.fixture
+def direct_turn_db(monkeypatch):
+    SessionLocal, engine, tmpfile = make_temp_sqlite(cdb.Base.metadata)
+    monkeypatch.setattr(session_manager_module, "SessionLocal", SessionLocal)
+    try:
+        yield SessionLocal
+    finally:
+        engine.dispose()
+        tmpfile.close()
+        try:
+            os.unlink(tmpfile.name)
+        except OSError:
+            pass
+
+
+def _manager():
+    manager = session_manager_module.SessionManager.__new__(
+        session_manager_module.SessionManager
+    )
+    manager.sessions = {}
+    manager.upload_handler = None
+    return manager
+
+
+def _seed_session(SessionLocal, *, owner="alice"):
+    session_id = "direct-" + uuid.uuid4().hex
+    db = SessionLocal()
+    try:
+        db.add(cdb.Session(
+            id=session_id,
+            owner=owner,
+            name="External direct turn",
+            model="test-model",
+            endpoint_url="http://localhost:11434",
+            archived=False,
+            message_count=0,
+        ))
+        db.commit()
+    finally:
+        db.close()
+    return session_id
+
+
+def _rows(SessionLocal, session_id):
+    db = SessionLocal()
+    try:
+        return [
+            {
+                "id": row.id,
+                "role": row.role,
+                "content": row.content,
+                "metadata": json.loads(row.meta_data) if row.meta_data else {},
+                "request_id": row.client_request_id,
+            }
+            for row in db.query(cdb.ChatMessage)
+            .filter(cdb.ChatMessage.session_id == session_id)
+            .order_by(cdb.ChatMessage.timestamp, cdb.ChatMessage.id)
+            .all()
+        ]
+    finally:
+        db.close()
+
+
+def test_identical_replay_returns_the_original_receipt(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-replay"
+    message = ChatMessage("user", "Keep this once", {"source": "mot-direct"})
+
+    first = _manager().put_idempotent_messages(session_id, request_id, [message])
+    replay = _manager().put_idempotent_messages(session_id, request_id, [message])
+
+    assert first["status"] == "inserted"
+    assert replay["status"] == "already_present"
+    assert first["messages"][0]["id"] == replay["messages"][0]["id"]
+    assert first["messages"][0]["inserted"] is True
+    assert replay["messages"][0]["inserted"] is False
+    assert _rows(SessionLocal, session_id) == [{
+        "id": first["messages"][0]["id"],
+        "role": "user",
+        "content": "Keep this once",
+        "metadata": {"source": "mot-direct"},
+        "request_id": request_id,
+    }]
+
+
+def test_partial_retry_adds_only_the_missing_role(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-partial"
+    user = ChatMessage("user", "Question", {"sequence": 1})
+    assistant = ChatMessage("assistant", "Answer", {"sequence": 2})
+
+    user_receipt = _manager().put_idempotent_messages(
+        session_id, request_id, [user]
+    )
+    completed = _manager().put_idempotent_messages(
+        session_id, request_id, [user, assistant]
+    )
+    replay = _manager().put_idempotent_messages(
+        session_id, request_id, [user, assistant]
+    )
+
+    assert completed["status"] == "inserted"
+    assert [row["inserted"] for row in completed["messages"]] == [False, True]
+    assert replay["status"] == "already_present"
+    assert [row["inserted"] for row in replay["messages"]] == [False, False]
+    assert completed["messages"][0]["id"] == user_receipt["messages"][0]["id"]
+    assert len(_rows(SessionLocal, session_id)) == 2
+
+
+def test_assistant_only_can_complete_an_existing_user_receipt(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-assistant-continuation"
+    manager = _manager()
+    manager.put_idempotent_messages(
+        session_id,
+        request_id,
+        [ChatMessage("user", "Question")],
+    )
+
+    completed = manager.put_idempotent_messages(
+        session_id,
+        request_id,
+        [ChatMessage("assistant", "Answer")],
+    )
+
+    assert completed["status"] == "inserted"
+    assert [row["role"] for row in _rows(SessionLocal, session_id)] == [
+        "user",
+        "assistant",
+    ]
+
+
+def test_assistant_cannot_be_the_first_receipt(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+
+    with pytest.raises(
+        session_manager_module.IdempotentMessageConflict,
+        match="requires an existing user receipt",
+    ):
+        _manager().put_idempotent_messages(
+            session_id,
+            "mot-direct:test-assistant-first",
+            [ChatMessage("assistant", "Must not precede its user")],
+        )
+
+    assert _rows(SessionLocal, session_id) == []
+
+
+@pytest.mark.parametrize(
+    "replacement",
+    [
+        ChatMessage("user", "Different text", {"sequence": 1}),
+        ChatMessage("user", "Question", {"sequence": 999}),
+    ],
+)
+def test_conflicting_replay_is_rejected_without_mutation(
+    direct_turn_db,
+    replacement,
+):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-conflict"
+    original = ChatMessage("user", "Question", {"sequence": 1})
+    manager = _manager()
+    manager.put_idempotent_messages(session_id, request_id, [original])
+    before = _rows(SessionLocal, session_id)
+
+    with pytest.raises(
+        session_manager_module.IdempotentMessageConflict,
+        match="different user content",
+    ):
+        manager.put_idempotent_messages(session_id, request_id, [replacement])
+
+    assert _rows(SessionLocal, session_id) == before
+
+
+def test_conflicting_replay_does_not_touch_attachment_reservations(
+    direct_turn_db,
+    monkeypatch,
+):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-attachment-conflict"
+    manager = _manager()
+    calls = []
+    monkeypatch.setattr(
+        session_manager_module,
+        "reserve_message_upload_references",
+        lambda *_args: calls.append(_args) or None,
+    )
+    manager.put_idempotent_messages(
+        session_id,
+        request_id,
+        [ChatMessage("user", "Original")],
+    )
+    calls.clear()
+
+    with pytest.raises(session_manager_module.IdempotentMessageConflict):
+        manager.put_idempotent_messages(
+            session_id,
+            request_id,
+            [ChatMessage("user", "Conflicting")],
+        )
+
+    assert calls == []
+
+
+def test_identical_attachment_replay_preserves_metadata_without_rereserving(
+    direct_turn_db,
+    monkeypatch,
+):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-attachment-replay"
+    attachment_id = "a" * 32 + ".txt"
+    metadata = {
+        "source": "mot-direct",
+        "attachments": [{"id": attachment_id, "name": "evidence.txt"}],
+    }
+    calls = []
+    monkeypatch.setattr(
+        session_manager_module,
+        "reserve_message_upload_references",
+        lambda *args: calls.append(args) or None,
+    )
+    manager = _manager()
+    message = ChatMessage("user", "Review the attachment", metadata)
+
+    first = manager.put_idempotent_messages(session_id, request_id, [message])
+    assert len(calls) == 1
+    calls.clear()
+    replay = manager.put_idempotent_messages(session_id, request_id, [message])
+
+    assert first["status"] == "inserted"
+    assert replay["status"] == "already_present"
+    assert calls == []
+    assert _rows(SessionLocal, session_id)[0]["metadata"] == metadata
+
+
+def test_missing_attachment_aborts_before_any_message_row(direct_turn_db, monkeypatch):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    monkeypatch.setattr(
+        session_manager_module,
+        "reserve_message_upload_references",
+        lambda *_args: "missing-upload",
+    )
+
+    with pytest.raises(
+        session_manager_module.IdempotentMessageUploadMissing,
+        match="missing-upload",
+    ):
+        _manager().put_idempotent_messages(
+            session_id,
+            "mot-direct:test-missing-upload",
+            [ChatMessage("user", "Attachment")],
+        )
+
+    assert _rows(SessionLocal, session_id) == []
+
+
+def test_concurrent_identical_writers_commit_one_row(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-race"
+    message = ChatMessage("user", "Race me once", {"source": "mot-direct"})
+
+    def write_once():
+        return _manager().put_idempotent_messages(
+            session_id, request_id, [message]
+        )
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
+        receipts = list(pool.map(lambda _index: write_once(), range(2)))
+
+    assert sorted(receipt["status"] for receipt in receipts) == [
+        "already_present",
+        "inserted",
+    ]
+    rows = _rows(SessionLocal, session_id)
+    assert len(rows) == 1
+    assert {
+        receipt["messages"][0]["id"] for receipt in receipts
+    } == {rows[0]["id"]}
+
+
+def test_concurrent_identical_pair_writers_commit_one_ordered_pair(direct_turn_db):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal)
+    request_id = "mot-direct:test-pair-race"
+
+    def write_once():
+        return _manager().put_idempotent_messages(
+            session_id,
+            request_id,
+            [
+                ChatMessage("user", "Question", {"sequence": 1}),
+                ChatMessage("assistant", "Answer", {"sequence": 2}),
+            ],
+        )
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
+        receipts = list(pool.map(lambda _index: write_once(), range(2)))
+
+    assert sorted(receipt["status"] for receipt in receipts) == [
+        "already_present",
+        "inserted",
+    ]
+    rows = _rows(SessionLocal, session_id)
+    assert [(row["role"], row["content"]) for row in rows] == [
+        ("user", "Question"),
+        ("assistant", "Answer"),
+    ]
+    stable_ids = {row["role"]: row["id"] for row in rows}
+    for receipt in receipts:
+        assert {row["role"]: row["id"] for row in receipt["messages"]} == stable_ids
+
