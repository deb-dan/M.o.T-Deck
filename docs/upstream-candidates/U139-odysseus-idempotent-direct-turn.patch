+def test_owner_change_serializes_behind_direct_turn_transaction(
+    direct_turn_db,
+    monkeypatch,
+):
+    SessionLocal = direct_turn_db
+    session_id = _seed_session(SessionLocal, owner="alice")
+    writer_locked = threading.Event()
+    release_writer = threading.Event()
+    rename_started = threading.Event()
+    rename_done = threading.Event()
+
+    def pause_after_owner_lock(*_args):
+        writer_locked.set()
+        assert release_writer.wait(5)
+        return None
+
+    monkeypatch.setattr(
+        session_manager_module,
+        "reserve_message_upload_references",
+        pause_after_owner_lock,
+    )
+
+    def write_turn():
+        return _manager().put_idempotent_messages(
+            session_id,
+            "mot-direct:test-owner-serialization",
+            [ChatMessage("user", "Owned at transaction start")],
+            owner="alice",
+        )
+
+    def rename_owner():
+        db = SessionLocal()
+        try:
+            rename_started.set()
+            row = db.query(cdb.Session).filter(cdb.Session.id == session_id).one()
+            row.owner = "bob"
+            db.commit()
+            rename_done.set()
+        finally:
+            db.close()
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
+        writer = pool.submit(write_turn)
+        assert writer_locked.wait(5)
+        renamer = pool.submit(rename_owner)
+        assert rename_started.wait(5)
+        assert not rename_done.wait(0.2)
+        release_writer.set()
+        receipt = writer.result(timeout=5)
+        renamer.result(timeout=5)
+
+    db = SessionLocal()
+    try:
+        assert db.query(cdb.Session).filter(cdb.Session.id == session_id).one().owner == "bob"
+    finally:
+        db.close()
+    assert receipt["status"] == "inserted"
+    assert [row["content"] for row in _rows(SessionLocal, session_id)] == [
+        "Owned at transaction start"
+    ]
+
