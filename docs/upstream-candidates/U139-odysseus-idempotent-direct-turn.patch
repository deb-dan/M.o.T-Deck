+                    # race between the route gate and this transaction. SQLite has
+                    # no row-level SELECT FOR UPDATE, so acquire its write lock
+                    # before the read; other supported databases lock the session
+                    # row itself without performing a data update.
+                    if db.get_bind().dialect.name == "sqlite":
+                        db.execute(text("BEGIN IMMEDIATE"))
+                    else:
